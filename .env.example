# Copy to .env (repository root). Django loads it automatically in development.

# Development: enables DEBUG and dev-only fallback secrets. Never set in production.
DJANGO_DEBUG="true"

# PostgreSQL (Neon pooled URL). Without it, development uses backend/dev.sqlite3.
NEON_DATABASE_URL=""
# Direct (unpooled) URL. Set DJANGO_USE_DIRECT_DATABASE_URL=true to use it, e.g. for migrations.
NEON_DATABASE_URL_UNPOOLED=""

# Must stay identical to the previous deployment so sessions and saved SMTP passwords keep working.
JWT_SECRET="generate-a-random-secret-with-at-least-32-characters"
SMTP_ENCRYPTION_KEY="generate-a-different-random-secret-with-at-least-32-characters"
# Optional; defaults to JWT_SECRET.
DJANGO_SECRET_KEY=""
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
APP_URL="http://localhost:8000"

OPENAI_API_KEY=""
# Low-cost model is pinned server-side to gpt-4o-mini.
REDIS_URL=""
TELEGRAM_BOT_TOKEN=""
# Protects GET /api/cron/auto-apply (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=""

# Seeding (python manage.py seed)
ADMIN_EMAIL="admin@ausbildung-finder.de"
ADMIN_PASSWORD="choose-a-strong-unique-password"
DEMO_PASSWORD="choose-a-separate-demo-password"

# Paiements par virement bancaire
BANK_ACCOUNT_HOLDER=""
BANK_NAME=""
# Renseignez BANK_RIB (notamment au Maroc), BANK_IBAN, ou les deux.
BANK_RIB=""
BANK_IBAN=""
BANK_BIC=""
BANK_TRANSFER_INSTRUCTIONS="Indiquez exactement la référence de paiement dans le motif du virement."
BILLING_ADMIN_EMAIL="admin@ausbildung-finder.de"

# SMTP de la plateforme (bienvenue, paiements et abonnements)
SYSTEM_SMTP_HOST=""
SYSTEM_SMTP_PORT="587"
SYSTEM_SMTP_SECURE="false"
SYSTEM_SMTP_USER=""
SYSTEM_SMTP_PASSWORD=""
SYSTEM_SMTP_FROM_EMAIL=""
SYSTEM_SMTP_FROM_NAME="Azubora"
